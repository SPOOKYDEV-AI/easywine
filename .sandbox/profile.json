{
  "version": 1,
  "runner": "node-web",
  "task": "smoke",
  "pipeline": {
    "install": "node scripts/check-runtime.js",
    "lint": [
      "node --check src/server/index.js",
      "node --check src/server/maintenance-cli.js",
      "node --check public/app.js",
      "node --check public/service.js",
      "node --check public/admin.js"
    ],
    "test": "npm test"
  },
  "serve": {
    "command": "node scripts/sandbox-audit-server.js",
    "readyPath": "/healthz",
    "startupTimeoutMs": 60000
  },
  "ui": {
    "enabled": true,
    "path": "/",
    "offline": false,
    "waitForSelector": "#login",
    "viewports": [
      {
        "name": "phone",
        "width": 390,
        "height": 844
      },
      {
        "name": "tablet",
        "width": 768,
        "height": 1024
      },
      {
        "name": "desktop",
        "width": 1440,
        "height": 900
      }
    ]
  }
}
