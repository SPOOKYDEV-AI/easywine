{
  "name": "easywine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node --watch src/server/index.js",
    "test": "node --test tests/*.test.js",
    "bootstrap": "node src/server/bootstrap.js",
    "check": "node --check src/server/index.js && node --check public/app.js && npm test",
    "backup": "node src/server/maintenance-cli.js"
  }
}
